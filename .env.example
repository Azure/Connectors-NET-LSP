# LSP Server Development Configuration
# Copy this to your VS Code launch.json env section

# Path to the development build of the LSP server DLL
# This will be used instead of the bundled production server when debugging the extension
LSP_SERVER_DEV_PATH=/path/to/your/Connectors-NET-LSP/Server/bin/Debug/net8.0/SdkLspServer.dll

# Note: Update this path to match your local clone of the Connectors-NET-LSP repository.
